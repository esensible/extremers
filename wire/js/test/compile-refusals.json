{
  "about": "Schemas outside the subset. compile() must throw a CompileError with an error at exactly `path` whose message contains `mentions`.",
  "cases": [
    { "name": "boolean schema", "schema": true, "path": "", "mentions": "boolean schemas" },
    { "name": "no type", "schema": {}, "path": "", "mentions": "missing 'type'" },
    { "name": "null type", "schema": { "type": "null" }, "path": "/type", "mentions": "leave its property out of 'required'" },
    { "name": "nullable type list", "schema": { "type": ["integer", "null"] }, "path": "/type", "mentions": "single string" },
    { "name": "nullable keyword", "schema": { "type": "integer", "nullable": true }, "path": "/nullable", "mentions": "required" },
    { "name": "unknown type", "schema": { "type": "decimal" }, "path": "/type", "mentions": "unknown type" },
    { "name": "unknown integer format", "schema": { "type": "integer", "format": "int128" }, "path": "/format", "mentions": "uint64" },
    { "name": "number format on integer", "schema": { "type": "integer", "format": "float" }, "path": "/format", "mentions": "int8" },
    { "name": "unknown number format", "schema": { "type": "number", "format": "decimal" }, "path": "/format", "mentions": "\"float\"" },
    { "name": "integer format on number", "schema": { "type": "number", "format": "int32" }, "path": "/format", "mentions": "\"type\": \"integer\"" },
    { "name": "old x-float keyword", "schema": { "type": "number", "x-float": 32 }, "path": "/x-float", "mentions": "format" },
    { "name": "unsupported contentEncoding", "schema": { "type": "string", "contentEncoding": "base16" }, "path": "/contentEncoding", "mentions": "base64" },
    { "name": "enum of numbers", "schema": { "enum": [1, 2] }, "path": "/enum/0", "mentions": "must be strings" },
    { "name": "enum duplicate", "schema": { "enum": ["a", "a"] }, "path": "/enum/1", "mentions": "duplicate" },
    { "name": "enum empty", "schema": { "enum": [] }, "path": "/enum", "mentions": "non-empty" },
    { "name": "enum of integer type", "schema": { "type": "integer", "enum": ["a"] }, "path": "/type", "mentions": "must be 'string'" },
    { "name": "const and enum", "schema": { "const": "a", "enum": ["a"] }, "path": "", "mentions": "not both" },
    { "name": "const number", "schema": { "const": 5 }, "path": "/const", "mentions": "must be strings" },
    { "name": "array without items", "schema": { "type": "array" }, "path": "", "mentions": "'items'" },
    { "name": "tuple", "schema": { "type": "array", "items": [{ "type": "boolean" }] }, "path": "/items", "mentions": "tuple" },
    { "name": "prefixItems", "schema": { "type": "array", "items": { "type": "boolean" }, "prefixItems": [] }, "path": "/prefixItems", "mentions": "tuples" },
    { "name": "array of a const", "schema": { "type": "array", "items": { "const": "k" } }, "path": "/items", "mentions": "encode to nothing" },
    { "name": "array of empty objects", "schema": { "type": "array", "items": { "type": "object" } }, "path": "/items", "mentions": "encode to nothing" },
    { "name": "required not in properties", "schema": { "type": "object", "properties": {}, "required": ["a"] }, "path": "/required/0", "mentions": "not in 'properties'" },
    { "name": "patternProperties", "schema": { "type": "object", "patternProperties": {} }, "path": "/patternProperties", "mentions": "list each one" },
    { "name": "index-like property name", "schema": { "type": "object", "properties": { "1": { "type": "boolean" } } }, "path": "/properties/1", "mentions": "array index" },
    { "name": "nested error path", "schema": { "type": "object", "properties": { "a": { "type": "object", "properties": { "b": { "type": "number", "format": "half" } } } } }, "path": "/properties/a/properties/b/format", "mentions": "\"double\"" },
    { "name": "anyOf", "schema": { "anyOf": [{ "type": "boolean" }] }, "path": "/anyOf", "mentions": "oneOf" },
    { "name": "allOf", "schema": { "type": "object", "allOf": [] }, "path": "/allOf", "mentions": "not supported" },
    { "name": "oneOf without tag", "schema": { "oneOf": [{ "type": "object", "properties": { "a": { "type": "boolean" } } }] }, "path": "/oneOf", "mentions": "tag property" },
    { "name": "oneOf of scalars", "schema": { "oneOf": [{ "type": "boolean" }] }, "path": "/oneOf/0", "mentions": "must be an object" },
    { "name": "oneOf ambiguous tag", "schema": { "oneOf": [{ "type": "object", "properties": { "a": { "const": "x" }, "b": { "const": "y" } }, "required": ["a", "b"] }] }, "path": "", "mentions": "discriminator" },
    { "name": "oneOf duplicate tag", "schema": { "oneOf": [{ "type": "object", "properties": { "t": { "const": "x" } }, "required": ["t"] }, { "type": "object", "properties": { "t": { "const": "x" } }, "required": ["t"] }] }, "path": "/oneOf/1", "mentions": "duplicate tag" },
    { "name": "discriminator names a non-tag", "schema": { "oneOf": [{ "type": "object", "properties": { "t": { "const": "x" } } }], "discriminator": { "propertyName": "t" } }, "path": "/oneOf/0", "mentions": "must be required" },
    { "name": "discriminator mapping", "schema": { "oneOf": [{ "type": "object", "properties": { "t": { "const": "x" } }, "required": ["t"] }], "discriminator": { "propertyName": "t", "mapping": {} } }, "path": "/discriminator/mapping", "mentions": "propertyName" },
    { "name": "remote ref", "schema": { "$ref": "other.json#/a" }, "path": "/$ref", "mentions": "local references" },
    { "name": "dangling ref", "schema": { "$ref": "#/$defs/Nope" }, "path": "/$ref", "mentions": "does not point" },
    { "name": "recursive ref", "schema": { "$defs": { "A": { "type": "object", "properties": { "a": { "$ref": "#/$defs/A" } } } }, "$ref": "#/$defs/A" }, "path": "/$defs/A/properties/a/$ref", "mentions": "recursive" },
    { "name": "ref with siblings", "schema": { "$defs": { "A": { "type": "boolean" } }, "$ref": "#/$defs/A", "type": "boolean" }, "path": "", "mentions": "cannot be combined" },
    { "name": "error inside a def keeps the def path", "schema": { "$defs": { "A": { "type": "integer", "format": "int7" } }, "type": "object", "properties": { "x": { "$ref": "#/$defs/A" } } }, "path": "/$defs/A/format", "mentions": "int8" },
    { "name": "$defs below the root", "schema": { "type": "object", "properties": { "a": { "type": "boolean", "$defs": {} } } }, "path": "/properties/a/$defs", "mentions": "only allowed at the root" },
    { "name": "enum of 257", "schema": { "enum": ["0a","1a","2a","3a","4a","5a","6a","7a","8a","9a","10a","11a","12a","13a","14a","15a","16a","17a","18a","19a","20a","21a","22a","23a","24a","25a","26a","27a","28a","29a","30a","31a","32a","33a","34a","35a","36a","37a","38a","39a","40a","41a","42a","43a","44a","45a","46a","47a","48a","49a","50a","51a","52a","53a","54a","55a","56a","57a","58a","59a","60a","61a","62a","63a","64a","65a","66a","67a","68a","69a","70a","71a","72a","73a","74a","75a","76a","77a","78a","79a","80a","81a","82a","83a","84a","85a","86a","87a","88a","89a","90a","91a","92a","93a","94a","95a","96a","97a","98a","99a","100a","101a","102a","103a","104a","105a","106a","107a","108a","109a","110a","111a","112a","113a","114a","115a","116a","117a","118a","119a","120a","121a","122a","123a","124a","125a","126a","127a","128a","129a","130a","131a","132a","133a","134a","135a","136a","137a","138a","139a","140a","141a","142a","143a","144a","145a","146a","147a","148a","149a","150a","151a","152a","153a","154a","155a","156a","157a","158a","159a","160a","161a","162a","163a","164a","165a","166a","167a","168a","169a","170a","171a","172a","173a","174a","175a","176a","177a","178a","179a","180a","181a","182a","183a","184a","185a","186a","187a","188a","189a","190a","191a","192a","193a","194a","195a","196a","197a","198a","199a","200a","201a","202a","203a","204a","205a","206a","207a","208a","209a","210a","211a","212a","213a","214a","215a","216a","217a","218a","219a","220a","221a","222a","223a","224a","225a","226a","227a","228a","229a","230a","231a","232a","233a","234a","235a","236a","237a","238a","239a","240a","241a","242a","243a","244a","245a","246a","247a","248a","249a","250a","251a","252a","253a","254a","255a","256a"] }, "path": "/enum", "mentions": "more than 256" },
    { "name": "too deep", "schema": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "boolean" } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } }, "path": "/items/items/items/items/items/items/items/items/items/items/items/items/items/items/items/items/items/items/items/items/items/items/items/items/items/items/items/items/items/items/items/items", "mentions": "deeper than 32" }
  ]
}
