  "inputs": [
    {
      "name": "state",
      "nullable": true,
      "schema": {
        "description": "Race's state: what the next evaluation needs, and what the view shows on an evaluation that carries no fix (bump, tap, wake). Clients receive the view (view.schema.json), not this. Times are epoch ms on the device clock; positions degrees; speeds knots; headings degrees true.",
        "properties": {
          "line": {
            "description": "The start line, as far as it has been set; kept while racing",
            "properties": {
              "crossing": {
                "description": "when the boat reaches the line on its course, as of the last GPS update before the gun with a fix, a velocity and both ends set; absent until the first",
                "format": "int64",
                "type": "integer"
              },
              "port": {
                "description": "the port end: the fix where it was set",
                "properties": {
                  "alt": {
                    "type": "number"
                  },
                  "lat": {
                    "type": "number"
                  },
                  "lon": {
                    "type": "number"
                  },
                  "t": {
                    "format": "int64",
                    "type": "integer"
                  }
                },
                "required": [
                  "t",
                  "lat",
                  "lon"
                ],
                "type": "object"
              },
              "stbd": {
                "description": "the starboard end: the fix where it was set",
                "properties": {
                  "alt": {
                    "type": "number"
                  },
                  "lat": {
                    "type": "number"
                  },
                  "lon": {
                    "type": "number"
                  },
                  "t": {
                    "format": "int64",
                    "type": "integer"
                  }
                },
                "required": [
                  "t",
                  "lat",
                  "lon"
                ],
                "type": "object"
              }
            },
            "type": "object"
          },
          "phase": {
            "description": "Where the race is: exactly one of idle, countdown (to the gun) and racing (since the gun)",
            "oneOf": [
              {
                "properties": {
                  "idle": {
                    "type": "object"
                  }
                },
                "required": [
                  "idle"
                ]
              },
              {
                "properties": {
                  "countdown": {
                    "properties": {
                      "gun": {
                        "description": "the start",
                        "format": "int64",
                        "type": "integer"
                      }
                    },
                    "required": [
                      "gun"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "countdown"
                ]
              },
              {
                "properties": {
                  "racing": {
                    "properties": {
                      "gun": {
                        "description": "the start",
                        "format": "int64",
                        "type": "integer"
                      }
                    },
                    "required": [
                      "gun"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "racing"
                ]
              }
            ]
          },
          "velocity": {
            "description": "speed over ground and course, as of the last GPS update that had them; absent until the first",
            "properties": {
              "heading": {
                "type": "number"
              },
              "speed": {
                "type": "number"
              }
            },
            "required": [
              "speed",
              "heading"
            ],
            "type": "object"
          }
        },
        "required": [
          "phase",
          "line"
        ],
        "type": "object"
      }
    },
    {
      "name": "event",
      "schema": {
        "oneOf": [
          {
            "properties": {
              "gps": {
                "properties": {
                  "fix": {
                    "properties": {
                      "alt": {
                        "type": "number"
                      },
                      "lat": {
                        "type": "number"
                      },
                      "lon": {
                        "type": "number"
                      },
                      "t": {
                        "format": "int64",
                        "type": "integer"
                      }
                    },
                    "required": [
                      "t",
                      "lat",
                      "lon"
                    ],
                    "type": "object"
                  },
                  "velocity": {
                    "properties": {
                      "heading": {
                        "type": "number"
                      },
                      "speed": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "speed",
                      "heading"
                    ],
                    "type": "object"
                  }
                },
                "type": "object"
              }
            },
            "required": [
              "gps"
            ]
          },
          {
            "properties": {
              "wake": {
                "type": "object"
              }
            },
            "required": [
              "wake"
            ]
          },
          {
            "properties": {
              "line_stbd": {
                "description": "set the starboard end where the boat is",
                "type": "object"
              }
            },
            "required": [
              "line_stbd"
            ]
          },
          {
            "properties": {
              "line_port": {
                "description": "set the port end where the boat is",
                "type": "object"
              }
            },
            "required": [
              "line_port"
            ]
          },
          {
            "properties": {
              "bump_seq": {
                "description": "not counting down: the gun `seconds` from the tap. Counting down: > 0 moves the gun earlier, < 0 later, 0 rounds the time left (from the tap) down to a whole minute",
                "properties": {
                  "seconds": {
                    "format": "int32",
                    "type": "integer"
                  },
                  "tapped_at": {
                    "description": "when the tap happened, on the device clock",
                    "format": "int64",
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "seconds",
                  "tapped_at"
                ],
                "type": "object"
              }
            },
            "required": [
              "bump_seq"
            ]
          },
          {
            "properties": {
              "race_finish": {
                "description": "finish the race, or abort the countdown",
                "type": "object"
              }
            },
            "required": [
              "race_finish"
            ]
          }
        ]
      }
    },
    {
      "name": "timestamp",
      "schema": {
        "format": "int64",
        "type": "integer"
      }
    },
    {
      "name": "gps",
      "schema": {
        "items": {
          "properties": {
            "alt": {
              "type": "number"
            },
            "lat": {
              "type": "number"
            },
            "lon": {
              "type": "number"
            },
            "t": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "t",
            "lat",
            "lon"
          ],
          "type": "object"
        },
        "maxItems": 57344,
        "type": "array"
      }
    }
  ],
