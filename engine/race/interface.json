                "properties": {
                  "alt": {
                    "type": "number"
                  },
                  "lat": {
                    "type": "number"
                  },
                  "lon": {
                    "type": "number"
                  },
                  "t": {
                    "format": "int64",
                    "type": "integer"
                  }
                },
                "required": [
                  "t",
                  "lat",
                  "lon"
                ],
                "type": "object"
              }
            },
            "type": "object"
          },
          "phase": {
            "description": "Where the race is: exactly one of idle, countdown (to the gun) and racing (since the gun)",
            "oneOf": [
              {
                "properties": {
                  "idle": {
                    "type": "object"
                  }
                },
                "required": [
                  "idle"
                ]
              },
              {
                "properties": {
                  "countdown": {
                    "properties": {
                      "gun": {
                        "description": "the start",
                        "format": "int64",
                        "type": "integer"
                      }
                    },
                    "required": [
                      "gun"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "countdown"
                ]
              },
              {
                "properties": {
                  "racing": {
                    "properties": {
                      "gun": {
                        "description": "the start",
                        "format": "int64",
                        "type": "integer"
                      }
                    },
                    "required": [
                      "gun"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "racing"
                ]
              }
            ]
          },
          "velocity": {
            "description": "speed over ground and course, as of the last GPS update that had them; absent until the first",
            "properties": {
              "heading": {
                "type": "number"
              },
              "speed": {
                "type": "number"
              }
            },
            "required": [
              "speed",
              "heading"
            ],
            "type": "object"
          }
        },
        "required": [
          "phase",
          "line"
        ],
        "type": "object"
      },
      "view": {
        "description": "Race's view: what clients receive, computed from the new state on every evaluation. Only what the clients show. Times are epoch ms on the device clock; speeds knots; headings degrees true.",
        "properties": {
          "crossing": {
            "description": "when the boat reaches the line on its course, as last predicted, for the time to the line (from now while idle, from the gun while counting down); absent while racing and until the first prediction",
            "format": "int64",
            "type": "integer"
          },
          "heading": {
            "description": "course over ground, shown while racing; absent otherwise, and until the first GPS update with a velocity",
            "type": "number"
          },
          "line": {
            "description": "Which ends of the start line are set, for the line buttons; with both, the clients show the time to the line instead. Shown while idle and counting down.",
            "properties": {
              "port": {
                "description": "the port end is set",
                "type": "boolean"
              },
              "stbd": {
                "description": "the starboard end is set",
                "type": "boolean"
              }
            },
            "required": [
              "stbd",
              "port"
            ],
            "type": "object"
          },
          "phase": {
            "description": "Where the race is, which picks the clients' page: exactly one of idle, countdown (to the gun) and racing (since the gun). The gun is what the countdown counts to and the race clock counts from.",
            "oneOf": [
              {
                "properties": {
                  "idle": {
                    "type": "object"
                  }
                },
                "required": [
                  "idle"
                ]
              },
              {
                "properties": {
                  "countdown": {
                    "properties": {
                      "gun": {
                        "description": "the start",
                        "format": "int64",
                        "type": "integer"
                      }
                    },
                    "required": [
                      "gun"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "countdown"
                ]
              },
              {
                "properties": {
                  "racing": {
                    "properties": {
                      "gun": {
                        "description": "the start",
                        "format": "int64",
                        "type": "integer"
                      }
                    },
                    "required": [
                      "gun"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "racing"
                ]
              }
            ]
          },
          "speed": {
            "description": "speed over ground, shown in every phase; absent until the first GPS update with a velocity",
            "type": "number"
          }
        },
        "required": [
          "phase",
          "line"
        ],
        "type": "object"
      },
      "wake": {
        "description": "when the host next delivers the `wake` event: epoch ms on the device clock; absent, no timer",
        "format": "int64",
        "type": "integer"
      }
    },
    "required": [
      "state",
      "view"
    ],
    "type": "object"
  }
