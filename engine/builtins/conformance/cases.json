{
  "about": "Conformance cases for the engine profile's builtins. Each runs on Go expr with spikes/expr-engines' Go builtins (lang/conformance/oracle, `sailing`) and on our compiler + VM with this crate's builtins; results must agree. A schema written {\"$name\": true} stands for defs.name.",
  "defs": {
    "pos": {"type": "object", "properties": {"lat": {"type": "number"}, "lon": {"type": "number"}}, "required": ["lat", "lon"]},
    "fix": {"type": "object", "properties": {"lat": {"type": "number"}, "lon": {"type": "number"}, "alt": {"type": "number"}}, "required": ["lat", "lon"]}
  },
  "cases": [
    {"name": "distance", "source": "distance(a, b)", "inputs": [{"name": "a", "schema": {"$pos": true}}, {"name": "b", "schema": {"$pos": true}}], "output": {"type": "number"},
     "runs": [{"a": {"lat": -33.8568, "lon": 151.2153}, "b": {"lat": -33.7969, "lon": 151.2875}},
              {"a": {"lat": -33.8568, "lon": 151.2153}, "b": {"lat": -33.8568, "lon": 151.2153}},
              {"a": {"lat": 51.4779, "lon": -0.0015}, "b": {"lat": -33.8568, "lon": 151.2153}},
              {"a": {"lat": 0, "lon": 179.9}, "b": {"lat": 0, "lon": -179.9}}]},
    {"name": "distance from a fix (an extra field)", "source": "distance(p, {lat: -33.85, lon: 151.2})", "inputs": [{"name": "p", "schema": {"$fix": true}}], "output": {"type": "number"},
     "runs": [{"p": {"lat": -33.86, "lon": 151.21, "alt": 12.5}}, {"p": {"lat": -33.86, "lon": 151.21}}]},
    {"name": "distance of int literals", "source": "distance({lat: 0, lon: 0}, {lat: 0, lon: 1})", "inputs": [], "output": {"type": "number"}, "runs": [{}]},
    {"name": "bearing", "source": "bearing(a, b)", "inputs": [{"name": "a", "schema": {"$pos": true}}, {"name": "b", "schema": {"$pos": true}}], "output": {"type": "number"},
     "runs": [{"a": {"lat": 0, "lon": 0}, "b": {"lat": 1, "lon": 0}},
              {"a": {"lat": 0, "lon": 0}, "b": {"lat": 0, "lon": 1}},
              {"a": {"lat": 0, "lon": 0}, "b": {"lat": -1, "lon": 0}},
              {"a": {"lat": 0, "lon": 0}, "b": {"lat": 0, "lon": -1}},
              {"a": {"lat": 0, "lon": 179.9}, "b": {"lat": 0, "lon": -179.9}},
              {"a": {"lat": -33.8568, "lon": 151.2153}, "b": {"lat": -33.7969, "lon": 151.2875}}]},
    {"name": "courses cross", "source": "courses_cross(a, h1, b, h2) ?? {lat: -999.0, lon: -999.0}",
     "inputs": [{"name": "a", "schema": {"$pos": true}}, {"name": "h1", "schema": {"type": "number"}}, {"name": "b", "schema": {"$pos": true}}, {"name": "h2", "schema": {"type": "number"}}],
     "output": {"$pos": true},
     "runs": [{"a": {"lat": 0, "lon": 0}, "h1": 45, "b": {"lat": 0, "lon": 1}, "h2": 315},
              {"a": {"lat": 0, "lon": 0}, "h1": 0, "b": {"lat": 0, "lon": 1}, "h2": 0},
              {"a": {"lat": -33.85, "lon": 151.25}, "h1": 10, "b": {"lat": -33.84, "lon": 151.27}, "h2": 280},
              {"a": {"lat": 0, "lon": 0}, "h1": 45, "b": {"lat": 0, "lon": 0}, "h2": 45}]},
    {"name": "courses cross within a range", "source": "courses_cross(a, 45, b, 315, r)?.lat ?? -999.0",
     "inputs": [{"name": "a", "schema": {"$pos": true}}, {"name": "b", "schema": {"$pos": true}}, {"name": "r", "schema": {"type": "number"}}],
     "output": {"type": "number"},
     "runs": [{"a": {"lat": 0, "lon": 0}, "b": {"lat": 0, "lon": 1}, "r": 1000},
              {"a": {"lat": 0, "lon": 0}, "b": {"lat": 0, "lon": 1}, "r": 1000000},
              {"a": {"lat": 0, "lon": 0}, "b": {"lat": 0, "lon": 1}, "r": 0}]},
    {"name": "a negative range fails", "source": "courses_cross(a, 45, b, 315, -1.0) == nil",
     "inputs": [{"name": "a", "schema": {"$pos": true}}, {"name": "b", "schema": {"$pos": true}}], "output": {"type": "boolean"},
     "runs": [{"a": {"lat": 0, "lon": 0}, "b": {"lat": 0, "lon": 1}}]},
    {"name": "lines cross", "source": "lines_cross(a1, a2, b1, b2) ?? {lat: -999.0, lon: -999.0}",
     "inputs": [{"name": "a1", "schema": {"$pos": true}}, {"name": "a2", "schema": {"$pos": true}}, {"name": "b1", "schema": {"$pos": true}}, {"name": "b2", "schema": {"$pos": true}}],
     "output": {"$pos": true},
     "runs": [{"a1": {"lat": 0, "lon": 0}, "a2": {"lat": 1, "lon": 1}, "b1": {"lat": 0, "lon": 1}, "b2": {"lat": 1, "lon": 0}},
              {"a1": {"lat": 0, "lon": 0}, "a2": {"lat": 1, "lon": 1}, "b1": {"lat": 0, "lon": 0}, "b2": {"lat": 1, "lon": 1}},
              {"a1": {"lat": 0, "lon": 0}, "a2": {"lat": 0, "lon": 0}, "b1": {"lat": 0, "lon": 1}, "b2": {"lat": 1, "lon": 0}},
              {"a1": {"lat": -33.84, "lon": 151.24}, "a2": {"lat": -33.84, "lon": 151.26}, "b1": {"lat": -33.85, "lon": 151.25}, "b2": {"lat": -33.83, "lon": 151.251}}]},
    {"name": "a course crosses a start line", "source": "course_crosses_line(pos, heading, pin, boat) ?? {lat: -999.0, lon: -999.0}",
     "inputs": [{"name": "pos", "schema": {"$fix": true}}, {"name": "heading", "schema": {"type": "number"}}, {"name": "pin", "schema": {"$pos": true}}, {"name": "boat", "schema": {"$pos": true}}],
     "output": {"$pos": true},
     "runs": [{"pos": {"lat": -33.85, "lon": 151.25, "alt": 0}, "heading": 0, "pin": {"lat": -33.84, "lon": 151.24}, "boat": {"lat": -33.84, "lon": 151.26}},
              {"pos": {"lat": -33.85, "lon": 151.25}, "heading": 90, "pin": {"lat": -33.84, "lon": 151.24}, "boat": {"lat": -33.84, "lon": 151.26}},
              {"pos": {"lat": -33.85, "lon": 151.25}, "heading": 0, "pin": {"lat": -33.84, "lon": 151.24}, "boat": {"lat": -33.84, "lon": 151.24}}]},
    {"name": "a crossing fed to distance", "source": "distance(a1, lines_cross(a1, a2, b1, b2) ?? a1)",
     "inputs": [{"name": "a1", "schema": {"$pos": true}}, {"name": "a2", "schema": {"$pos": true}}, {"name": "b1", "schema": {"$pos": true}}, {"name": "b2", "schema": {"$pos": true}}],
     "output": {"type": "number"},
     "runs": [{"a1": {"lat": 0, "lon": 0}, "a2": {"lat": 1, "lon": 1}, "b1": {"lat": 0, "lon": 1}, "b2": {"lat": 1, "lon": 0}},
              {"a1": {"lat": 0, "lon": 0}, "a2": {"lat": 1, "lon": 1}, "b1": {"lat": 0, "lon": 0}, "b2": {"lat": 1, "lon": 1}}]},
    {"name": "bearing to a crossing", "source": "let x = courses_cross(a, 45, b, 315); x == nil ? -1.0 : bearing(a, x ?? a)",
     "inputs": [{"name": "a", "schema": {"$pos": true}}, {"name": "b", "schema": {"$pos": true}}], "output": {"type": "number"},
     "runs": [{"a": {"lat": 0, "lon": 0}, "b": {"lat": 0, "lon": 1}}, {"a": {"lat": 0, "lon": 0}, "b": {"lat": 0, "lon": 0}}]}
  ]
}
