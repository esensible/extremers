    {
      "description": "heading a minus heading b, degrees, wrapped to -180..180 (positive: a is clockwise of b); extreme-race's simple_diff, in degrees",
      "name": "angle_diff",
      "params": [
        {
          "name": "a",
          "schema": {
            "type": "number"
          }
        },
        {
          "name": "b",
          "schema": {
            "type": "number"
          }
        }
      ],
      "result": {
        "type": "number"
      }
    }
  ],
  "inputs": [
    {
      "name": "state",
      "nullable": true,
      "schema": {
        "properties": {
          "evals": {
            "format": "int32",
            "maximum": 1000000000,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "evals"
        ],
        "type": "object"
      }
    },
    {
      "name": "event",
      "schema": {
        "oneOf": [
          {
            "properties": {
              "gps": {
                "properties": {
                  "fix": {
                    "properties": {
                      "alt": {
                        "type": "number"
                      },
                      "lat": {
                        "type": "number"
                      },
                      "lon": {
                        "type": "number"
                      },
                      "t": {
                        "format": "int64",
                        "type": "integer"
                      }
                    },
                    "required": [
                      "t",
                      "lat",
                      "lon"
                    ],
                    "type": "object"
                  },
                  "velocity": {
                    "properties": {
                      "heading": {
                        "type": "number"
                      },
                      "speed": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "speed",
                      "heading"
                    ],
                    "type": "object"
                  }
                },
                "type": "object"
              }
            },
            "required": [
              "gps"
            ]
          },
          {
            "properties": {
              "wake": {
                "type": "object"
              }
            },
            "required": [
              "wake"
            ]
          }
        ]
      }
    },
    {
      "name": "timestamp",
      "schema": {
        "format": "int64",
        "type": "integer"
      }
    },
    {
      "name": "gps",
      "schema": {
        "items": {
          "properties": {
            "alt": {
              "type": "number"
            },
            "lat": {
              "type": "number"
            },
            "lon": {
              "type": "number"
            },
            "t": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "t",
            "lat",
            "lon"
          ],
          "type": "object"
        },
        "maxItems": 20480,
        "type": "array"
      }
    }
  ],
  "output": {
    "properties": {
      "state": {
        "properties": {
          "evals": {
            "format": "int32",
            "maximum": 1000000000,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "evals"
        ],
        "type": "object"
      },
      "view": {
        "properties": {
          "m": {
            "type": "number"
          },
          "n": {
            "format": "int32",
            "maximum": 61,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "m",
          "n"
        ],
        "type": "object"
      },
      "wake": {
        "description": "when the host next delivers the `wake` event: epoch ms on the device clock; absent, no timer",
        "format": "int64",
        "type": "integer"
      }
    },
    "required": [
      "state",
      "view"
    ],
    "type": "object"
  }
}
